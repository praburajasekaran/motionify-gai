# API endpoints to Netlify Functions
/api/*  /.netlify/functions/:splat  200

# Missing Vite assets must not fall through to the SPA entrypoint. Stale
# browser sessions can request old hashed chunks after a deploy; serving
# index.html for those URLs causes strict MIME module errors.
/assets/*.map  /404  404!
/assets/*  /404  404!

# Handle React Client-Side Routing for known SPA routes
/verify-inquiry  /index.html  200
/proposal/*  /index.html  200
/payment/*  /index.html  200
/payments/proforma/*  /index.html  200
/inquiry-status/*  /index.html  200
/portal  /index.html  200
/portal/*  /index.html  200
/about  /index.html  200
/contact  /index.html  200
/work  /index.html  200
/login  /index.html  200
/project-access  /index.html  200
